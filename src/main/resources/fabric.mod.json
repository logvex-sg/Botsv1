{
  "schemaVersion": 1,
  "id": "logvex-hunter",
  "version": "${version}",
  "name": "Logvex Hunter",
  "description": "One mod, two jobs. Hunter: a player tracker, combat coordinator, equipment manager, defensive stasis system and in-game swarm control for Meteor Client. Worker: dials out to a Logvex Fleet Manager controller so this client can be driven remotely (status, inventory, regear, efly, command, chat).",
  "authors": [
    "Logvex"
  ],
  "contact": {
    "sources": "https://github.com/logvex-sg/Botsv1"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.logvex.worker.WorkerMod"
    ],
    "meteor": [
      "com.logvex.hunter.HunterAddon",
      "com.logvex.worker.meteor.FleetAddon"
    ]
  },
  "mixins": [
    "logvex-hunter.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "145,61,226",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=0.16.0",
    "meteor-client": "*"
  }
}

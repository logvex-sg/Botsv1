{
  "schemaVersion": 1,
  "id": "logvex-hunter",
  "version": "${version}",
  "name": "Logvex Hunter",
  "description": "A modular hunter dashboard, player tracker, combat coordinator, equipment manager, defensive stasis system and in-game swarm control for Meteor Client.",
  "authors": [
    "Logvex"
  ],
  "contact": {
    "sources": "https://github.com/logvex-sg/Botsv1"
  },
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "com.logvex.hunter.HunterAddon"
    ]
  },
  "mixins": [
    "logvex-hunter.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "145,61,226",
    "modmenu": {
      "parent": {
        "id": "meteor-client"
      }
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
